# Public site URL, no trailing slash. Used for links in email, sitemap, and checkout.
NEXT_PUBLIC_SITE_URL=https://vizonix.com

# IndexNow key. Optional override of the committed key in lib/indexnow.ts.
# The site serves that key at /37974ccaf24526ab8e10a675a3fa4935.txt
# A real publish pings IndexNow with this key, or the committed key when this is empty.
INDEXNOW_KEY=

# Google Search Console. Leave the JSON empty to skip sitemaps.submit (it is logged).
# Paste the service-account JSON, or a path to that file. Do not commit the file.
# The service account email must be a user on the Search Console property.
# Scope requested: https://www.googleapis.com/auth/webmasters
GSC_SERVICE_ACCOUNT_JSON=
# Exact property. Defaults to https://www.vizonix.com/
# Domain property example: sc-domain:vizonix.com
GSC_SITE_URL=
# Sitemap passed to sitemaps.submit. Defaults to https://www.vizonix.com/sitemap.xml
GSC_SITEMAP_URL=

# Random secret for confirm, unsubscribe, and topic links. Generate with: openssl rand -base64 32
TOKEN_SECRET=

# Cloudflare Turnstile. Both are required in production. Leave them empty in local dev and tests:
# the app then uses Cloudflare's documented always-pass test keys. Do not use the test secret in production.
# Site key is public. Secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Reader topic choices and sponsor admin. Server only. Do not prefix these with NEXT_PUBLIC_.
# Apply these files in the Supabase SQL editor first. The app does not apply them.
# supabase/migrations/20261021143000_reader_personalization.sql
# supabase/migrations/20261022090000_sponsor_admin.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin/sponsors. One admin session. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=

# Bearer token for POST /api/publish. Generate with: openssl rand -base64 32
PUBLISH_SECRET=

# Resend. Audiences were renamed to Segments in November 2025.
# Create one segment per section and put its id here.
# RESEND_AUDIENCE_ID_* is a legacy alias, used only if the segment id is empty.
RESEND_API_KEY=
EMAIL_FROM=Vizonix <admin@vizonix.com>
RESEND_SEGMENT_ID_AVIATION=
RESEND_AUDIENCE_ID_AVIATION=

# Optional. Single-address test send when a segment id is not set, or when you pass --test-to.
RESEND_TEST_TO=

# Owner alerts for a confirmed subscriber, a sponsor purchase, and a sponsor inquiry.
# Comma-separated. Defaults to admin@vizonix.com,tyshewmake@gmail.com.
# Sent from EMAIL_FROM through Resend. admin@ must be allowed on the verified domain.
NOTIFY_EMAIL=admin@vizonix.com,tyshewmake@gmail.com

# Legacy single recipient. Included with the default list only when NOTIFY_EMAIL is unset.
OPS_EMAIL=

# Stripe secret key and the webhook signing secret for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ids. Primary and secondary are one-time Prices. The middle token is the segment slug.
# Section sponsors are quoted and have no Stripe price.
# Founding: prefer STRIPE_FOUNDING_PROMOTION_CODE (a promo_ id, not the word FOUNDING).
# Coupon: 50% off, duration repeating, duration_in_months 3, max_redemptions 10.
# Do not also set the _FOUNDING price ids. Checkout will not combine a founding Price with the promo.
# If the promo is unset, checkout uses the optional _FOUNDING Price and turns other codes off.
# Repeat the same keys for each live section. The example below uses the launch section slug.
STRIPE_PRICE_AVIATION_PRIMARY=
STRIPE_PRICE_AVIATION_PRIMARY_FOUNDING=
STRIPE_PRICE_AVIATION_SECONDARY=
STRIPE_PRICE_AVIATION_SECONDARY_FOUNDING=
STRIPE_FOUNDING_PROMOTION_CODE=

# Optional Payment Links. Used as extra buttons on /sponsor. They do not replace Checkout.
# Custom field keys the webhook understands: segment, placement, preferred_week (YYYY-MM-DD).
NEXT_PUBLIC_STRIPE_LINK_AVIATION_PRIMARY=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_SECONDARY=

# LinkedIn company-page post after a real broadcast. Leave LINKEDIN_AUTOPOST empty until Unipile is ready.
# UNIPILE_DSN is the API base, for example https://api1.unipile.com:13111
# UNIPILE_ACCOUNT_ID and LINKEDIN_ORG_ID_VIZONIX are optional. If empty, publish resolves the first
# LinkedIn account and the organization named Vizonix, then logs those ids.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
LINKEDIN_ORG_ID_VIZONIX=
LINKEDIN_AUTOPOST=

# Lets the publish API and the Stripe webhook commit content on Vercel.
# Fine-grained token, Contents: Read and write, this repository only.
GITHUB_TOKEN=
GITHUB_REPO=owner/vizonix
GITHUB_BRANCH=main
