# Public site URL, no trailing slash. Used for links in email, sitemap, and checkout.
NEXT_PUBLIC_SITE_URL=https://vizonix.com

# IndexNow key. Generate with: openssl rand -hex 16
# Set the value in Vercel. Do not commit it. The site serves it at /{key}.txt
INDEXNOW_KEY=

# Random secret for confirm and unsubscribe links. Generate with: openssl rand -base64 32
TOKEN_SECRET=

# Bearer token for POST /api/publish. Generate with: openssl rand -base64 32
PUBLISH_SECRET=

# Resend. Audiences were renamed to Segments in November 2025.
# Create one segment per section and put its id here.
# RESEND_AUDIENCE_ID_* is a legacy alias, used only if the segment id is empty.
RESEND_API_KEY=
EMAIL_FROM=Vizonix <news@vizonix.com>
RESEND_SEGMENT_ID_AVIATION=
RESEND_SEGMENT_ID_LEGAL=
RESEND_SEGMENT_ID_WAREHOUSING=
RESEND_SEGMENT_ID_MARKETING_SALES=
RESEND_AUDIENCE_ID_AVIATION=
RESEND_AUDIENCE_ID_LEGAL=
RESEND_AUDIENCE_ID_WAREHOUSING=
RESEND_AUDIENCE_ID_MARKETING_SALES=

# Optional. Single-address test send when a segment id is not set, or when you pass --test-to.
RESEND_TEST_TO=

# Optional. Booking and sponsor-inquiry mail. Defaults to admin@vizonix.com.
# Sent from hello@vizonix.com through Resend. hello@ must be allowed on the verified domain.
OPS_EMAIL=

# Stripe secret key and the webhook signing secret for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ids. Featured (STRIPE_PRICE_*_FEATURED) must be a monthly recurring Price.
# Every other placement is a one-time Price.
# Founding: prefer STRIPE_FOUNDING_PROMOTION_CODE (a promo_ id, not the word FOUNDING).
# Coupon: 50% off, duration repeating, duration_in_months 3, max_redemptions 10.
# Do not also set the _FOUNDING price ids. Checkout will not combine a founding Price with the promo.
# If the promo is unset, checkout uses the optional _FOUNDING Price and turns other codes off.
# Aviation is the launch section. Repeat the same keys for each live section.
STRIPE_PRICE_AVIATION_PRIMARY=
STRIPE_PRICE_AVIATION_PRIMARY_FOUNDING=
STRIPE_PRICE_AVIATION_SECONDARY=
STRIPE_PRICE_AVIATION_SECONDARY_FOUNDING=
STRIPE_PRICE_AVIATION_CLASSIFIED=
STRIPE_PRICE_AVIATION_CLASSIFIED_FOUNDING=
STRIPE_PRICE_AVIATION_BANNER=
STRIPE_PRICE_AVIATION_BANNER_FOUNDING=
STRIPE_PRICE_AVIATION_FEATURED=
STRIPE_PRICE_AVIATION_FEATURED_FOUNDING=
STRIPE_PRICE_AVIATION_BUNDLE=
STRIPE_PRICE_AVIATION_BUNDLE_FOUNDING=
STRIPE_PRICE_LEGAL_PRIMARY=
STRIPE_PRICE_LEGAL_PRIMARY_FOUNDING=
STRIPE_PRICE_LEGAL_SECONDARY=
STRIPE_PRICE_LEGAL_SECONDARY_FOUNDING=
STRIPE_PRICE_LEGAL_CLASSIFIED=
STRIPE_PRICE_LEGAL_CLASSIFIED_FOUNDING=
STRIPE_PRICE_LEGAL_BANNER=
STRIPE_PRICE_LEGAL_BANNER_FOUNDING=
STRIPE_PRICE_LEGAL_FEATURED=
STRIPE_PRICE_LEGAL_FEATURED_FOUNDING=
STRIPE_PRICE_LEGAL_BUNDLE=
STRIPE_PRICE_LEGAL_BUNDLE_FOUNDING=
STRIPE_FOUNDING_PROMOTION_CODE=

# Optional Payment Links. Used as extra buttons on /sponsor. They do not replace Checkout.
# Custom field keys the webhook understands: segment, placement, preferred_week (YYYY-MM-DD).
NEXT_PUBLIC_STRIPE_LINK_AVIATION_PRIMARY=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_SECONDARY=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_CLASSIFIED=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_BANNER=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_FEATURED=
NEXT_PUBLIC_STRIPE_LINK_AVIATION_BUNDLE=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_PRIMARY=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_SECONDARY=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_CLASSIFIED=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_BANNER=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_FEATURED=
NEXT_PUBLIC_STRIPE_LINK_LEGAL_BUNDLE=

# LinkedIn company-page post after a real broadcast. Leave LINKEDIN_AUTOPOST empty until Unipile is ready.
# UNIPILE_DSN is the API base, for example https://api1.unipile.com:13111
# UNIPILE_ACCOUNT_ID and LINKEDIN_ORG_ID_VIZONIX are optional. If empty, publish resolves the first
# LinkedIn account and the organization named Vizonix, then logs those ids.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
LINKEDIN_ORG_ID_VIZONIX=
LINKEDIN_AUTOPOST=

# Lets the publish API and the Stripe webhook commit content on Vercel.
# Fine-grained token, Contents: Read and write, this repository only.
GITHUB_TOKEN=
GITHUB_REPO=owner/vizonix
GITHUB_BRANCH=main
